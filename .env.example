# Copie este archivo a .env y cambie las contraseñas. El archivo .env NUNCA se sube a git.

# --- Postgres local (Docker) ---
POSTGRES_DB=sobusa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambie_esto_admin
LECTOR_PASSWORD=cambie_esto_lector
ESCRITOR_PASSWORD=cambie_esto_escritor

# --- Conexiones de la aplicación ---
# Local: los dos usuarios de docker/initdb. Con Extreme: los usuarios que ellos entreguen.
DATABASE_URL_READ=postgresql+psycopg://sobusa_lector:cambie_esto_lector@db:5432/sobusa
DATABASE_URL_WRITE=postgresql+psycopg://sobusa_escritor:cambie_esto_escritor@db:5432/sobusa
ESQUEMA_FUENTE=public
# Marca de agua: progvehiculos no tiene columna de actualización. "fin_resultado" usa
# COALESCE(fecha_fin_liquidacion, fechafin): cuándo quedó disponible el resultado del viaje.
COLUMNA_MARCA_AGUA=fin_resultado
# Días hacia atrás que se releen en cada carga para capturar correcciones
DIAS_REVISION=3

# --- Notificaciones (simuladas: se registran en notification_log y en los logs) ---
NOTIFICACIONES_SIMULADAS=true
ALERTAS_CORREO_DESTINO=operaciones@ejemplo.com
ALERTAS_WHATSAPP_DESTINO=+570000000000

NIVEL_LOG=INFO

# --- Modelo (E01) ---
# Carpeta de artefactos del GBM (en Docker la fija docker-compose: /app/modelos)
MODELOS_DIR=modelos
# Línea base que se usa si el GBM activo no puede predecir: dia_hora_4sem, dia_hora_8sem o ultima_semana
METODO_RESPALDO=dia_hora_4sem
