# Copiar a deploy/programador/programador.env y completar. Horas en hora de Bogotá, HH:MM[:SS], separadas
# por coma. NO hay valores por defecto: sin PROGRAMADOR_CICLO_HORAS y PROGRAMADOR_VERIFICADOR_HORAS el
# programador no arranca.
#
# PENDIENTE DE VALIDACIÓN OPERATIVA (DECISIONES §16.2): las horas del ciclo y del verificador deben salir
# de la política de ALT-009 por retraso (apertura, vencimiento y tolerancia) acordada con Extreme o con el
# responsable operativo. Los valores de abajo están vacíos a propósito.
PROGRAMADOR_CICLO_HORAS=
PROGRAMADOR_VERIFICADOR_HORAS=
# Opcional: predicción y recomendación del día siguiente (ALT-001 a ALT-004 e incompletitud de ALT-009).
PROGRAMADOR_FRECUENCIAS_HORAS=
PROGRAMADOR_PREFIJO=programador

# Política de ALT-009 por retraso (sin valores por defecto; sin ella el retraso es no_evaluable).
ALT009_RETRASO_APERTURA=
ALT009_RETRASO_VENCIMIENTO=
ALT009_RETRASO_TOLERANCIA_MIN=
ALT009_RETRASO_POLITICA_VERSION=
ALT009_RETRASO_INICIO_MONITOREO=

# ALT-008: habilita la referencia timbradas_anio de Extreme (lectura). Dejar vacío hasta que Extreme
# confirme el significado y el período del consolidado (ver docs/ALERTAS_ALT001_ALT010.md, ALT-008).
ALT008_REFERENCIA=
